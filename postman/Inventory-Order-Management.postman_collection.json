{
  "info": {
    "name": "Inventory & Order Management",
    "_postman_id": "2e2d6b8f-5f3d-4f65-a0b2-1b5f5b3e6a01",
    "description": "Basic request collection for the Inventory & Order Management API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Create Category",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\"\n}"
        },
        "url": "{{baseUrl}}/api/categories"
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"Business laptop\",\n  \"price\": 60000,\n  \"categoryId\": 1\n}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Update Inventory",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 10,\n  \"reorderLevel\": 3\n}"
        },
        "url": "{{baseUrl}}/api/inventory/1"
      }
    },
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"phone\": \"9876543210\"\n}"
        },
        "url": "{{baseUrl}}/api/customers"
      }
    },
    {
      "name": "Place Order",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Get Orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Cancel Order",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/orders/1/cancel"
      }
    }
  ]
}
